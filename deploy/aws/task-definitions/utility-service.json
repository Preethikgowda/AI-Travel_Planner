{
  "family": "ai-travel-utility-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "<ecs-task-execution-role-arn>",
  "taskRoleArn": "<ecs-task-role-arn>",
  "containerDefinitions": [
    {
      "name": "utility-service",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/ai-travel-utility-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "JWT_ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://app.example.com"
        }
      ],
      "secrets": [
        {
          "name": "OPENWEATHER_API_KEY",
          "valueFrom": "<secrets-manager-openweather-api-key-arn>"
        },
        {
          "name": "GEOAPIFY_API_KEY",
          "valueFrom": "<secrets-manager-geoapify-api-key-arn>"
        },
        {
          "name": "GOOGLE_MAPS_API_KEY",
          "valueFrom": "<secrets-manager-google-maps-api-key-arn>"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "<secrets-manager-jwt-secret-key-arn>"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health').read()\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-travel/utility-service",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
