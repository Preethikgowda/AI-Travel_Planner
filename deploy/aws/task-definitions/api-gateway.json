{
  "family": "ai-travel-api-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "<ecs-task-execution-role-arn>",
  "taskRoleArn": "<ecs-task-role-arn>",
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/ai-travel-api-gateway:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://user-service.ai-travel.local:8000"
        },
        {
          "name": "TRAVEL_SERVICE_URL",
          "value": "http://travel-service.ai-travel.local:8000"
        },
        {
          "name": "AI_SERVICE_URL",
          "value": "http://ai-service.ai-travel.local:8000"
        },
        {
          "name": "UTILITY_SERVICE_URL",
          "value": "http://utility-service.ai-travel.local:8000"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://app.example.com"
        },
        {
          "name": "RATE_LIMIT",
          "value": "240/minute"
        },
        {
          "name": "UPSTREAM_TIMEOUT_SECONDS",
          "value": "45"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health').read()\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-travel/api-gateway",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
