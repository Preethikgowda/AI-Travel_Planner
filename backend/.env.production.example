ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://ai_travel:<db-password>@<rds-endpoint>:5432/ai_travel
JWT_SECRET_KEY=<store-in-aws-secrets-manager>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://app.example.com
GROQ_API_KEY=<store-in-aws-secrets-manager-or-leave-empty>
OPENWEATHER_API_KEY=<store-in-aws-secrets-manager-or-leave-empty>
GEOAPIFY_API_KEY=<store-in-aws-secrets-manager-or-leave-empty>
GOOGLE_MAPS_API_KEY=<store-in-aws-secrets-manager-or-leave-empty>
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<optional-if-using-iam-role>
AWS_SECRET_ACCESS_KEY=<optional-if-using-iam-role>
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:<topic-name>
S3_DOCUMENT_BUCKET=ai-travel-planner-prod-documents
S3_DOCUMENT_KMS_KEY_ID=arn:aws:kms:us-east-1:<account-id>:key/<key-id>
S3_PRESIGNED_URL_EXPIRES_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760
S3_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain,text/markdown,application/json,text/csv
